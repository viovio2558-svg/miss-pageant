{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "miss-pageant",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "miss-pageant-db",
      "database_id": "REPLACE_WITH_YOUR_DATABASE_ID"
    }
  ]
}
